# Este arquivo é apenas referência
# As variáveis reais serão configuradas no Render

# Database
DATABASE_URL="postgresql://user:password@host/database?schema=public"

# JWT
JWT_SECRET="seu-secret-sera-gerado-automaticamente"
JWT_EXPIRES_IN="1h"
# Refresh token: MUST differ from JWT_SECRET; both need >= 32 chars in production
REFRESH_TOKEN_SECRET="your-super-secret-refresh-key-change-this-in-production"
REFRESH_TOKEN_EXPIRES_IN="30d"

# Server
PORT=3333
NODE_ENV="production"

# CORS (URL do frontend na Vercel)
CORS_ORIGIN="https://seu-frontend.vercel.app"

CNAE_TOKEN=xxxxxx
CNAE_URL="https://api.listacnae.com.br/v1/todosCnaes"