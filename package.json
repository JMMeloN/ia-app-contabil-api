{
  "name": "iacontabil-api",
  "version": "1.0.0",
  "description": "API Backend para o sistema IAContabil - Solicitação de Notas Fiscais",
  "main": "dist/main/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/main/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/main/server.js",
    "postbuild": "npx prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:deploy": "prisma migrate deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "cnae:import": "tsx scripts/import-cnaes.ts"
  },
  "keywords": [
    "nodejs",
    "typescript",
    "clean-architecture",
    "api",
    "rest"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.2",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "nfe-io": "^3.0.2",
    "prisma": "^6.19.1",
    "resend": "^6.6.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.12",
    "nodemon": "^3.1.11",
    "tsx": "^4.21.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.12",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "picomatch@2": "2.3.2",
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
